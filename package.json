{
  "name": "fortune-journal-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check": "npm run test && npm run check:static && npm run typecheck && npm run build",
    "test:db": "bash scripts/test-db.sh",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:pure-types": "node scripts/check-pure-types.mjs",
    "db:prepare": "node scripts/prepare-migrations.mjs",
    "db:check-prepared": "node scripts/prepare-migrations.mjs --check",
    "release:check": "npm run db:check-prepared && npm run check && npm run test:db",
    "ops": "node --experimental-strip-types scripts/ops.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "mcp-handler": "2.3.0",
    "next": "15.5.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.8.3"
  }
}
