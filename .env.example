# Copy to .env.local; never commit real values. All example keys are intentionally unusable.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_BACKEND_ONLY_SECRET
# Independent random secrets: generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REQUEST_HMAC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TAROT_HMAC_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
TAROT_KEY_VERSION=v1
OPS_HMAC_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
ATTRIBUTION_HMAC_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
CRON_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
# Global switch AND each user's explicit consent are required.
PRODUCT_ANALYTICS_ENABLED=false
OPERATIONS_ENABLED=false
THREADS_INSIGHTS_ENABLED=false
THREADS_PUBLISH_ENABLED=false
THREADS_ACCOUNT_ID=
THREADS_ACCESS_TOKEN=
# Set an API version currently supported by Meta after checking official documentation.
# v1.0 appears in the official example; this is NOT a claim that it is the newest version.
THREADS_API_VERSION=
# Verified Supabase OAuth client IDs only. Client != acquisition channel.
MCP_CLIENT_NAMES_JSON={}
# Google login secrets belong in Supabase/Google provider settings, not this app's client.
# Customer Google Sheets/Drive tokens and LLM API keys are NOT used.
# No real payment provider is connected. /api/billing/webhook remains HTTP 501.
