{
  "name": "fortune-journal-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "next build",
    "check": "npm run format:check && npm run check:static && npm test && npm run typecheck && npm run build",
    "check:static": "node scripts/check-static.mjs",
    "db:schema": "bash scripts/db-schema.sh",
    "db:schema:check": "bash scripts/db-schema.sh --check",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ops": "node --experimental-strip-types scripts/ops.mjs",
    "release:check": "npm run check && npm run test:db && npm run db:schema:check && npm audit --audit-level=high",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:db": "bash scripts/test-db.sh",
    "test:db:supabase": "bash scripts/test-supabase-local.sh",
    "test:e2e:local": "node --experimental-strip-types scripts/e2e-local.mjs --out verification/e2e_local.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "mcp-handler": "2.3.0",
    "next": "15.5.27",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.9",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.30",
    "sharp": "0.35.5"
  }
}
